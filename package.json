{
  "name": "cc-live",
  "version": "1.0.0",
  "description": "Live streaming and remote control for Claude Code terminal sessions",
  "bin": {
    "cc-live": "./dist/client/index.js",
    "cc-live-server": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:client": "tsx src/client/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "start:server": "node dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
